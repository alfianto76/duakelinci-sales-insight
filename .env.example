# Salin jadi .env lalu isi. Semua opsional: tanpa ini dashboard tetap jalan.

# Claude untuk menulis ringkasan (tanpa ini dipakai template).
ANTHROPIC_API_KEY=

# Bot Telegram: buat bot lewat @BotFather, lalu ambil chat_id grup/pribadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wajib di server publik: password untuk memakai Claude dan tombol kirim Telegram.
# Kosong = semua orang bisa (aman hanya di laptop sendiri).
APP_PASSWORD=
